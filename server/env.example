# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=jcc_factory
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=jcc_factory
QUOTA_LOCK_CONNECTION_LIMIT=4
QUOTA_LOCK_QUEUE_LIMIT=32

# JWT密钥（同时用于会话签名及派生 AI 服务商密钥加密键；轮换后需重新输入已存服务商密钥）
JWT_SECRET=replace_with_at_least_32_random_characters

# MinIO/S3 compatible object storage
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET=jcc-factory
MAX_USER_STORAGE_BYTES=5368709120
MAX_CONCURRENT_UPLOADS_PER_USER=2
MAX_DOCUMENT_STORAGE_BYTES=536870912
MAX_KNOWLEDGE_STORAGE_BYTES=5368709120
MINIO_REGION=us-east-1

# Google Gemini API (optional until AI tasks are used)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_AVAILABLE_MODELS=gemini-3.6-flash
# 文本生成可能需要输出完整剧本，允许 30-600 秒；默认 180 秒
AI_PROVIDER_TIMEOUT_MS=180000
PYTHON_COMMAND=
FFMPEG_COMMAND=ffmpeg

# 服务器配置
PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SESSION_COOKIE_SECURE=false

# Initial administrator setup
AUTO_PROVISION_ADMIN=false
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 文件上传配置
UPLOAD_PATH=./uploads
